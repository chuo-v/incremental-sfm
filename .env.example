# .env.example
# Copy this file, rename to .env, and update the path to match your system.

# Local Mac/Linux Example:
# DATA_DIR=/Users/john/Incremental_SfM/datasets

# Local Windows Example (Note: You can use standard backslashes or forward slashes, pathlib will handle it):
# DATA_DIR=D:\Incremental_SfM\datasets

# Google Colab Example:
# DATA_DIR=/content/drive/MyDrive/Incremental_SfM/datasets

DATA_DIR=YOUR_LOCAL_OR_COLAB_PATH_HERE